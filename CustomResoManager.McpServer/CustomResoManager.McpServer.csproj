<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CustomResoManager.McpServer</RootNamespace>
    <AssemblyName>CustomResoManager.McpServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official C# MCP SDK: ModelContextProtocol.AspNetCore (ASP.NET Core + Streamable HTTP) -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="*-*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reuse the existing Win32 tooling from the main project WITHOUT pulling in WPF.
      Core/ and Models/ have no WPF dependency, so we link the source files directly
      instead of referencing the WinExe/WPF project.
    -->
    <Compile Include="..\Models\DisplaySettingModel.cs" Link="Linked\DisplaySettingModel.cs" />
    <Compile Include="..\Models\GameProfile.cs" Link="Linked\GameProfile.cs" />
    <Compile Include="..\Core\NativeMethods.cs" Link="Linked\NativeMethods.cs" />
    <Compile Include="..\Core\ResolutionManager.cs" Link="Linked\ResolutionManager.cs" />
    <Compile Include="..\Core\AspectRatioCalculator.cs" Link="Linked\AspectRatioCalculator.cs" />
    <Compile Include="..\Core\ProfileManager.cs" Link="Linked\ProfileManager.cs" />
    <Compile Include="..\Core\AppEngine.cs" Link="Linked\AppEngine.cs" />
  </ItemGroup>

</Project>
