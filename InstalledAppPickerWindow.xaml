<Window x:Class="CustomResoManager.InstalledAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tất cả ứng dụng trên máy" Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <DockPanel Margin="12">

        <!-- Search -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Tìm:" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontFamily="Segoe UI" FontSize="13"/>
            <TextBox x:Name="txtSearch" FontFamily="Segoe UI" FontSize="13"
                     Padding="6,5" TextChanged="txtSearch_TextChanged"/>
        </DockPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="txtCount" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontFamily="Segoe UI" FontSize="11" Foreground="#757575"/>
            <Button x:Name="btnCancel" Content="Hủy" Click="btnCancel_Click"
                    Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
            <Button x:Name="btnOk" Content="Thêm vào danh sách" Click="btnOk_Click"
                    Background="#1565C0" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Padding="14,6" Cursor="Hand"/>
        </StackPanel>

        <!-- App list -->
        <DataGrid x:Name="dgApps"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE"
                  AlternatingRowBackground="#FAFAFA"
                  RowHeight="30"
                  FontFamily="Segoe UI" FontSize="13"
                  MouseDoubleClick="dgApps_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ứng dụng" Binding="{Binding DisplayName}" Width="240"/>
                <DataGridTextColumn Header="Đường dẫn shortcut" Binding="{Binding LnkPath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
