<Window x:Class="CustomResoManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Resolution Manager" Height="680" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Flat button with hover/press opacity -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Header bar ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#263238" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Custom Resolution Manager"
                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>

                <!-- Status + current resolution (centered) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="statusDot" Width="10" Height="10" CornerRadius="5"
                            Background="#607D8B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtStatus" Text="Engine Stopped"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="#90A4AE" VerticalAlignment="Center"/>
                    <TextBlock Text="   ·   "
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="#546E7A" VerticalAlignment="Center"/>
                    <TextBlock Text="Resolution: "
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="#90A4AE" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCurrentRes" Text="—"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                               Foreground="#80CBC4" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnToggleEngine" Grid.Column="2"
                        Content="▶  Start Engine"
                        Click="btnToggleEngine_Click"
                        Background="#2E7D32" Foreground="White"
                        FontWeight="Bold" FontSize="13" Padding="16,8"
                        Style="{StaticResource FlatButton}"/>
            </Grid>
        </Border>

        <!-- ── Main content ────────────────────────────────────────────────── -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: profile management ────────────────────────────────── -->
            <DockPanel Grid.Column="0">

                <!-- Add Profile form — pinned to bottom -->
                <GroupBox DockPanel.Dock="Bottom" Header="Add Profile" Margin="0,10,0,0" Padding="8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>

                        <!-- Labels -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="btnPickProcess"
                                    Content="Tiến trình đang chạy…"
                                    Click="btnPickProcess_Click"
                                    Background="#455A64" Foreground="White"
                                    FontSize="11" Padding="8,2" Margin="8,0,0,0"
                                    Style="{StaticResource FlatButton}"/>
                            <Button DockPanel.Dock="Right" x:Name="btnBrowseFile"
                                    Content="Chọn file…"
                                    Click="btnBrowseFile_Click"
                                    Background="#455A64" Foreground="White"
                                    FontSize="11" Padding="8,2" Margin="8,0,0,0"
                                    Style="{StaticResource FlatButton}"/>
                            <TextBlock Text="Process Name — nhập tên, chọn file .exe/.lnk, hoặc chọn tiến trình đang chạy"
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#757575"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Grid.Column="2" Text="Resolution"
                                   FontFamily="Segoe UI" FontSize="11" Foreground="#757575"/>
                        <TextBlock Grid.Column="4" Text="Refresh Rate"
                                   FontFamily="Segoe UI" FontSize="11" Foreground="#757575"/>

                        <!-- Inputs -->
                        <TextBox x:Name="txtProcessName" Grid.Row="2"
                                 ToolTip="Nhập tên tiến trình, hoặc dùng nút Chọn file… / Tiến trình đang chạy…"/>
                        <ComboBox x:Name="cmbResolution" Grid.Row="2" Grid.Column="2"
                                  SelectionChanged="cmbResolution_SelectionChanged"/>
                        <ComboBox x:Name="cmbRefreshRate" Grid.Row="2" Grid.Column="4"/>
                        <Button Grid.Row="2" Grid.Column="6"
                                Content="Save" Click="btnSaveProfile_Click"
                                Background="#1565C0" Foreground="White"
                                FontWeight="SemiBold" Padding="0,7"
                                Style="{StaticResource FlatButton}"/>
                    </Grid>
                </GroupBox>

                <!-- Profile list — fills remaining height -->
                <GroupBox Header="Game Profiles" Padding="4">
                    <DockPanel>

                        <!-- Active profile indicator -->
                        <Border x:Name="activeProfileBanner" DockPanel.Dock="Bottom"
                                Background="#E8F5E9" BorderBrush="#A5D6A7"
                                BorderThickness="0,1,0,0" Padding="10,7"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="#2E7D32" Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtActiveProfile"
                                           FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="Bold" Foreground="#1B5E20"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="dgProfiles"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#FAFAFA"
                                  BorderThickness="0"
                                  RowHeight="36"
                                  FontFamily="Segoe UI"
                                  FontSize="13">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#ECEFF1"/>
                                    <Setter Property="Foreground" Value="#546E7A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#CFD8DC"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>

                                <!-- On/Off toggle -->
                                <DataGridTemplateColumn Header="On" Width="45"
                                                        CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="chkEnabled_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Process name -->
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}"
                                                    Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Resolution (editable per app) -->
                                <DataGridTemplateColumn Header="Resolution" Width="130" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Tag="{Binding ProcessName}"
                                                      SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                                      ItemsSource="{Binding ResolutionOptions,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectionChanged="dgResolution_SelectionChanged"
                                                      VerticalAlignment="Center" Margin="4,3"
                                                      FontSize="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Aspect ratio -->
                                <DataGridTextColumn Header="Ratio" Binding="{Binding ExpectedAspectRatio}"
                                                    Width="60" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#757575"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Refresh rate -->
                                <DataGridTextColumn Header="Hz" Binding="{Binding RefreshRateDisplay}"
                                                    Width="52" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#757575"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Delete -->
                                <DataGridTemplateColumn Header="" Width="74"
                                                        CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete"
                                                    Tag="{Binding ProcessName}"
                                                    Click="btnDeleteProfile_Click"
                                                    Background="#E53935" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand"
                                                    Padding="6,3" Margin="6,4"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource FlatButton}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </DockPanel>

            <!-- ── Splitter ────────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DCDCDC"/>

            <!-- ── Right: AI chat ──────────────────────────────────────────── -->
            <GroupBox Grid.Column="2" Header="AI Assistant" Padding="6">
                <DockPanel>

                    <!-- Connection status -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border x:Name="chatStatusDot" Width="8" Height="8" CornerRadius="4"
                                Background="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txtChatStatus"
                                   Text="Disconnected"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="#9E9E9E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Input row -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChatInput" Padding="8,8"
                                 KeyDown="txtChatInput_KeyDown"/>
                        <Button x:Name="btnSendChat" Grid.Column="2"
                                Content="Send" Click="btnSendChat_Click"
                                Background="#1565C0" Foreground="White"
                                FontWeight="SemiBold" Padding="14,0"
                                Style="{StaticResource FlatButton}"/>
                    </Grid>

                    <!-- Chat log -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
                        <TextBox x:Name="txtChatLog"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="10"
                                 Background="#FAFAFA"
                                 FontFamily="Segoe UI" FontSize="12"
                                 VerticalContentAlignment="Top"/>
                    </Border>

                </DockPanel>
            </GroupBox>

        </Grid>
    </DockPanel>
</Window>
