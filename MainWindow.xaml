<Window x:Class="CustomResoManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test CustomResoManager Backend" Height="520" Width="820">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Target Process Name (VD: notepad):" FontWeight="Bold"/>
            <TextBox x:Name="txtProcessName" Text="notepad" Margin="0,5,0,15" Padding="2" />

            <TextBlock Text="Target Width:" FontWeight="Bold"/>
            <TextBox x:Name="txtWidth" Text="800" Margin="0,5,0,15" Padding="2" />

            <TextBlock Text="Target Height:" FontWeight="Bold"/>
            <TextBox x:Name="txtHeight" Text="600" Margin="0,5,0,15" Padding="2" />

            <Button x:Name="btnAddProfile" Click="btnAddProfile_Click" Content="Save Profile to JSON" Height="30" Margin="0,0,0,15" Background="#eee"/>

            <TextBlock x:Name="txtProfiles" Text="Saved Profiles: None" Margin="0,0,0,15" TextWrapping="Wrap"/>
            <Separator Margin="0,0,0,15"/>

            <Button x:Name="btnToggleEngine" Click="btnToggleEngine_Click" Content="Start Engine" Height="40" Margin="0,0,0,10" FontWeight="Bold" FontSize="14" Background="#d4edda"/>

            <TextBlock x:Name="txtStatus" Text="Status: Engine Stopped" Foreground="Red" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Chatbot (Mock)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

            <TextBox x:Name="txtChatLog" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtChatInput" Grid.Column="0" Margin="0,0,8,0" Padding="4" KeyDown="txtChatInput_KeyDown" />
                <Button x:Name="btnSendChat" Grid.Column="1" Click="btnSendChat_Click" Content="Send" Padding="12,4" />
            </Grid>
        </Grid>
    </Grid>
</Window>
